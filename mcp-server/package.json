{
  "name": "nextjs-starter-mcp",
  "version": "1.0.0",
  "description": "MCP server for creating Next.js applications with the create-next-starter.sh script",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "nextjs-starter-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "prepublish": "npm run build",
    "test": "tsc -p tsconfig.test.json && tsx --test src/*.test.ts",
    "lint": "npx eslint src/",
    "watch": "tsc --watch"
  },
  "keywords": [
    "nextjs",
    "mcp",
    "claude",
    "claude-desktop",
    "starter",
    "template",
    "convex",
    "clerk",
    "typescript",
    "tailwindcss",
    "automation",
    "boilerplate",
    "ai-tools"
  ],
  "author": "Your Name",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/next-starter.git",
    "directory": "mcp-server"
  },
  "homepage": "https://github.com/yourusername/next-starter#readme",
  "bugs": {
    "url": "https://github.com/yourusername/next-starter/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.0.0",
    "convex": "1.48.0",
    "convex-test": "0.0.65",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.72.0",
    "validate-npm-package-name": "^8.0.0"
  },
  "overrides": {
    "zod": "^4.6.6"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/",
    "README.md"
  ]
}
